{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": false,
        "strictNullChecks": true,
        "maxNodeModuleJsDepth": 0,
        "resolveJsonModule": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext"
    },
    "exclude": ["node_modules"]
}
